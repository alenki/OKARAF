ner('wheel', hold, { passive: false });\n    window.addEventListener('touchmove', hold, { passive: false });\n\n    function paint(n) {\n      if (n === shown) return;\n      shown = n;\n      var s = n \u003e 99 ? '100' : n \u003e 9 ? '0' + n : '00' + n;\n      for (var i = 0; i \u003c 3; i++) {\n        if (R[i].textContent !== s.charAt(i)) R[i].textContent = s.charAt(i);\n      }\n    }\n\n    function snyat() {\n      if (done) return;\n      done = true;\n      paint(100);\n      pusti();\n      setTimeout(function () {\n        H.setAttribute('data-press', 'run');\n        mk.setAttribute('data-mk', 'lift');\n        setTimeout(function () { mk.setAttribute('data-mk', 'done'); }, 260);\n      }, HOLD);\n    }\n\n    function frame(now) {\n      if (done) return;\n      var el = now - t0;\n      if (el \u003e= MAX) { snyat(); return; }\n\n      // ОДИН ПАНДУС ПОДНИМАЕТ И ПОТОЛОК, И СКОРОСТЬ. Потолок без скорости\n      // умеет только задержать счёт: множитель демпфера обрезан единицей\n      // сверху, и обогнать VMIN счётчик не мог ни при какой готовности.\n      var rel = tLoad ? Math.min(1, (now - tLoad) / REL) : 0;\n      var creep = Math.min(0.99, base + (1 - base) * el / MAX);\n      var ceil = creep + (1 - creep) * rel;\n      var v = VMIN + (VRDY - VMIN) * rel;\n\n      var dt = Math.min(50, now - last);\n      last = now;\n      p = Math.min(ceil, p + v * Math.min(1, Math.max(FLOOR, (ceil - p) / BAND)) * dt);\n\n      if (!STEP || now - tPaint \u003e= STEP) {\n        tPaint = now;\n        paint(Math.min(100, Math.floor(p * 100)));\n      }\n      if (p \u003e 0.9999) { snyat(); return; }\n      requestAnimationFrame(frame);\n    }\n\n    function pusk() {\n      if (t0 || done) return;\n      t0 = last = tPaint = performance.now();\n      mk.setAttribute('data-mk', 'ink');\n      requestAnimationFrame(frame);\n      setTimeout(snyat, MAX + 600);\n    }\n    if (D.fonts \u0026\u0026 D.fonts.ready \u0026\u0026 D.fonts.ready.then) D.fonts.ready.then(pu