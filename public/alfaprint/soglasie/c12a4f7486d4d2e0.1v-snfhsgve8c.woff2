ет",value:1},{label:"A5",value:1.2},{label:"A4",value:1.35},{label:"Многостраничный буклет",value:1.55}],finishes:[{label:"Без отделки",value:0},{label:"Фальцовка",value:700},{label:"Скрепление",value:1100},{label:"Ламинация обложки",value:1400}],rec:"Для буклетов важны формат, количество сгибов и плотность бумаги."},{id:"menus",title:"Меню / прайс-листы",base:35,min:1800,materials:[{label:"Плотная бумага",value:1},{label:"Картон",value:1.25},{label:"Ламинированное меню",value:1.45},{label:"Дизайнерская бумага",value:1.65}],formats:[{label:"A5",value:1},{label:"A4",value:1.25},{label:"Евроформат",value:1.45},{label:"Многостраничное меню",value:1.65}],finishes:[{label:"Без отделки",value:0},{label:"Матовая ламинация",value:600},{label:"Глянцевая ламинация",value:700},{label:"Премиальная защита",value:1400}],rec:"Для меню лучше выбирать ламинацию, чтобы материал служил дольше."},{id:"certificates",title:"Сертификаты / дипломы",base:28,min:1800,materials:[{label:"Плотная бумага 250 г/м²",value:1},{label:"Картон 300 г/м²",value:1.25},{label:"Дизайнерская бумага",value:1.45},{label:"Премиальная бумага",value:1.65}],formats:[{label:"A5",value:1},{label:"A4",value:1.25},{label:"Индивидуальный размер",value:1.45}],finishes:[{label:"Без отделки",value:0},{label:"Ламинация",value:600},{label:"Скругление углов",value:950},{label:"Премиальная отделка",value:1400}],rec:"Для сертификатов важен плотный материал и аккуратный премиальный вид."},{id:"tags",title:"Бирки",base:22,min:1800,materials:[{label:"Картон",value:1},{label:"Плотный картон",value:1.25},{label:"Дизайнерская бумага",value:1.45},{label:"Сатиновая бирка",value:1.65},{label:"Силиконовая / спец. бирка",value:1.85}],formats:[{label:"Стандартная бирка",value:1},{label:"Фигурная бирка",value:1.2},{label:"Бирка с отверстием",value:1.35},{label:"Индивидуальный размер",value:1.55}],finishes:[{label:"Без отделки",value:0},{label:"Ламинация",value:600},{label:"Фигурная резка",value:950},{label:"Отверстие / люверс",value:500},