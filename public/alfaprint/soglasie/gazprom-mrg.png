j7jxitinza.js" async=""></script><script src="/alfaprint/_next/static/chunks/1kvb285k5ih0i.js" async=""></script><script src="/alfaprint/_next/static/chunks/23t_1liu6ph4c.js" async=""></script><script src="/alfaprint/_next/static/chunks/2hka_804tm9eo.js" async=""></script><script src="/alfaprint/_next/static/chunks/2dywqye67s_75.js" async=""></script><meta name="theme-color" content="#121110"/><meta name="color-scheme" content="light"/><title>Контакты | Альфа Принт</title><meta name="description" content="Как связаться с «Альфа Принт» в Нальчике: телефон, WhatsApp, Telegram, MAX, часы работы. Бланк обращения, дорога до входа со двора на Тарчокова, 29, и план квартала. Самовывоз и доставка по городу."/><meta name="keywords" content="рекламное агентство Нальчик,типография Нальчик,полиграфия Нальчик,печать визиток Нальчик,наклейки на заказ Нальчик,бирки для одежды Нальчик,печать на футболках Нальчик,кружки с логотипом Нальчик,сувениры с логотипом Нальчик,баннеры Нальчик,лазерная резка Нальчик,гравировка Нальчик,УФ-печать КБР"/><meta name="robots" content="index, follow"/><link rel="canonical" href="https://lumako.ru/alfaprint/kontakty/"/><meta name="format-detection" content="telephone=no"/><meta property="og:title" content="Контакты | Альфа Принт"/><meta property="og:description" content="Телефон, WhatsApp, Telegram и MAX, часы цеха, бланк заказа и дорога до входа со двора: Нальчик, Тарчокова, 29, напротив ресторана History."/><meta property="og:locale" content="ru_RU"/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content="Контакты | Альфа Принт"/><meta name="twitter:description" content="Телефон, WhatsApp, Telegram и MAX, часы цеха, бланк заказа и дорога до входа со двора: Нальчик, Тарчокова, 29, напротив ресторана History."/><link rel="icon" href="/alfaprint/icon.svg?icon.06ugqlbj050bc.svg" sizes="any" type="image/svg+xml"/><meta name="next-size-adjust" content=""/><script src="/alfaprint/_next/static/chunks/0cz1d0mv5g_q7.js" noModule=""></script></head><body><div hidden=""><!--$--><!--/$--></div><a href="#main" class="skip-link t-label">К содержанию</a><noscript><style>
