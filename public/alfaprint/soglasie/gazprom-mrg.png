oute/04-560.webp 560w, /alfaprint/route/04-720.webp 720w, /alfaprint/route/04.webp 1000w" sizes="78vw" alt="" width="1000" height="753" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" style="object-position:34% center"/></div><figcaption class="rule-t t-micro fg truncate px-[clamp(8px,2vw,14px)] py-2.5">Двор жилого дома</figcaption></figure></li><li class="rule-r w-[78vw] shrink-0 snap-start snap-always last:border-r-0"><figure><div class="relative aspect-[4/3] overflow-hidden"><span aria-hidden="true" class="t-micro absolute left-0 top-0 z-1 px-[clamp(7px,0.62vw,13px)] py-[clamp(5px,0.44vw,9px)] leading-none tabular-nums" style="background-color:var(--color-rubine);color:var(--color-chalk);transition:background-color 260ms var(--ease-ink)">05/05</span><img src="/alfaprint/route/05.webp" srcSet="/alfaprint/route/05-560.webp 560w, /alfaprint/route/05-720.webp 720w, /alfaprint/route/05.webp 1000w" sizes="78vw" alt="" width="1000" height="753" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" style="object-position:center"/></div><figcaption class="rule-t t-micro fg truncate px-[clamp(8px,2vw,14px)] py-2.5">Вход: штендер у двери</figcaption></figure></li></ul></div></div></section><section id="plan" data-section-ground="ink" style="--gain:0.6" class="relative isolate ground-ink ink-warmth overflow-hidden pt-[var(--section-pad)]"><div class="sheet relative z-1"><div class="grid12 gap-y-[clamp(26px,2.8vw,52px)]"><div class="col-span-4 md:col-span-7"><div data-reveal="true" class="" style="clip-path:inset(102% 0 0 0)"><h2 class="t-h2 fg"><span class="block">Забрать можно самим,</span><span class="block">а по городу привезём.</span></h2></div></div><div class="col-span-4 md:col-span-4 md:col-start-9"><p data-reveal="true" class="t-lead fg-70 measure" style="clip-path:inset(102% 0 0 0)">Самовывоз со двора на Тарчокова, 29, и доставка по Нальчику. Повторный тираж печатаем по уже согласованному макету: заново считать и рисовать его не нужно.</p><div data-reveal="true" class="mt-[clamp(18px,1.8vw,32px)]" style="clip-path:inset(102% 0 0 0)"><a href="https://yandex.ru/maps/org/alfa/147173314874/" target="_blank" rel="noreferrer" class="t-micro link-rule fg-56">Открыть в Яндекс.Картах</a></div></div></div><div class="mt-[clamp(40px,4.4vw,96px)]"><a href="https://yandex.ru/maps/org/alfa/147173314874/" target="_blank" rel="noreferrer" class="cp" aria-label="Открыть в Яндекс.Картах: Нальчик, Тарчокова, 29"><span class="cp-frame"><svg viewBox="0 0 1200 540" preserveAspectRatio="xMidYMid slice" class="cp-film" aria-hidden="true" fill="none"><g stroke="color-mix(in srgb, currentColor 36%, transparent)" stroke-width="1" fill="color-mix(in srgb, currentColor 9%, transparent)"><path d="M222 162.4L343.5 36.6L429.4 124.2L309.3 252.7L222 162.4Z" vector-effect="non-scaling-stroke"></path><path d="M378.7 -336.2L420.2 -289.2L461.8 -242.2L503.3 -195.2L544.9 -148.1L586.4 -101.1L627.9 -54.1L669.5 -7.1L623.8 33.3L333 -295.9L378.7 -336.2Z" vector-effect="non-scaling-stroke"></path><path d="M1103.2 427.5L1156.3 378.6L1209.4 329.6L1262.5 280.7L1315.6 231.8L1368.7 182.9L1421.8 133.9L1474.9 85L1528 36.1L1581.1 -12.9L1618.3 27.4L1140.4 467.9L1103.2 427.5Z" vector-effect="non-scaling-stroke"></path><path d="M-53.4 813.1L-57 881.3L180.8 893.9L206 418.8L-3.6 407.7L-6.2 456.7L-8.1 492.6L75.1 497L110.5 498.9L126.6 499.8L124.3 542.4L120.2 620.4L113.7 742.2L109.4 821.8L80.5 820.2L-11.7 815.3L-53.4 813.1Z" vector-effect="non-scaling-stroke"></path><path d="M660.7 321L842.6 498.1L828.9 512.1L834.7 517.7L802.2 551.2L796.7 545.9L781.5 561.5L720.7 502.3L660 443.2L599.3 384Z" vector-effect="non-scaling-stroke"></path><path d="M592.2 230L672.9 308.5L594.7 388.8L514 310.3Z" vector-effect="non-scaling-stroke"></path><path d="M566.3 361.2L554.1 373.7L572.1 391.3L513.3 450.9L454.5 510.6L395.7 570.2L392.3 654.1L389 737.9L385.6 821.8L364.5 820.9L364.2 827.4L318.6 825.6L318.9 819.6L302.9 818.9L313 566.9L315.7 552.1L3