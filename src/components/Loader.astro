---
// The old % loader, now a darkroom timer. Shown once per visit (see pages/home.ts).
---

<div class="loader" data-loader role="status" aria-label="Loading">
  <p class="label loader-label">Developing</p>
  <p class="loader-timer" aria-hidden="true"><span data-digit>0</span><span data-digit>0</span><span class="loader-colon">:</span><span data-digit>0</span><span data-digit>0</span></p>
  <div class="loader-bar"><span data-loader-bar></span></div>
  <p class="label loader-note">Dev 1+9 · 20 °C · keep the door shut</p>
</div>
