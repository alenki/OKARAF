---
import type { SuitName } from '../data/site';

interface Props {
  name: SuitName;
  size?: number;
}
const { name, size = 16 } = Astro.props;
---

<svg class="suit" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
  {name === 'heart' && <path d="M12 20.5s-7.5-4.6-9.2-9.1C1.6 8 3.6 4.5 7 4.5c2 0 3.4 1.1 5 3 1.6-1.9 3-3 5-3 3.4 0 5.4 3.5 4.2 6.9C19.5 15.9 12 20.5 12 20.5Z" />}
  {name === 'spade' && <path d="M12 3.5s-7.5 5.6-7.5 10.2c0 2.5 1.9 4.2 4.1 4.2 1.3 0 2.4-.6 3-1.5-.2 1.9-1 3.3-2.6 4.6h6c-1.6-1.3-2.4-2.7-2.6-4.6.6.9 1.7 1.5 3 1.5 2.2 0 4.1-1.7 4.1-4.2C19.5 9.1 12 3.5 12 3.5Z" />}
  {name === 'club' && <path d="M12 13.2v7.3m-2.6 0h5.2M12 11a3.6 3.6 0 1 0 0-7.2A3.6 3.6 0 0 0 12 11Zm-4.4 5.8a3.6 3.6 0 1 0 0-7.2 3.6 3.6 0 0 0 0 7.2Zm8.8 0a3.6 3.6 0 1 0 0-7.2 3.6 3.6 0 0 0 0 7.2Z" />}
  {name === 'diamond' && <path d="M12 3l7 9-7 9-7-9 7-9Z" />}
  {name === 'crown' && <path d="M4 19h16M4.6 16.5 3.5 7.5l5 4L12 5l3.5 6.5 5-4-1.1 9H4.6Z" />}
  {name === 'moon' && <path d="M14.5 4.2a8 8 0 1 0 5.2 13.4A7.3 7.3 0 0 1 14.5 4.2Zm4.6 1.1.6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4-1.4-.6 1.4-.6.6-1.4Z" />}
</svg>
